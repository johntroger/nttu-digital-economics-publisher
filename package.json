{
  "name": "nttu-digital-economics-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-clean.mjs test",
    "test:stages": "node scripts/run-clean.mjs test tests/production-stages.test.mjs",
    "test:runner": "node scripts/run-clean.mjs test tests/production-runner.test.mjs",
    "test:runner:native": "node scripts/run-clean.mjs script scripts/production-runner-smoke.mjs",
    "test:production-live": "node scripts/run-clean.mjs script scripts/production-live-smoke.mjs",
    "check": "npm run typecheck && npm test",
    "catalog": "node scripts/catalog.mjs",
    "simulate": "node scripts/simulate.mjs",
    "samples": "node scripts/samples.mjs build",
    "samples:review": "node scripts/build-sample-review.mjs",
    "batch:build": "node scripts/batch.mjs",
    "test:images": "node scripts/run-clean.mjs images",
    "test:portable": "node scripts/run-clean.mjs portable",
    "check:repository": "node scripts/check-repository.mjs",
    "check:ci": "npm run typecheck && npm run test:portable && npm run check:repository",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:cloud": "node scripts/run-clean.mjs cloud",
    "test:cloud:workflow": "node scripts/run-clean.mjs workflow",
    "test:quota": "node scripts/run-clean.mjs test tests/public-actions-quota.test.mjs tests/production-budget.test.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
    "wrangler": "4.147.0"
  }
}
