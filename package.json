{
  "name": "nttu-digital-economics-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "catalog": "node scripts/catalog.mjs",
    "simulate": "node scripts/simulate.mjs",
    "samples": "node scripts/samples.mjs build",
    "test:images": "node scripts/samples.mjs test",
    "test:portable": "node scripts/test-portable.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:ci": "npm run typecheck && npm run test:portable && npm run check:repository",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz"
  }
}
